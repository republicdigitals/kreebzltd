generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Property {
  id               String   @id
  price            String
  address          String
  neighbourhood    String
  city             String
  beds             Int
  baths            Int
  status           String
  type             String
  priceValue       Int
  lat              Float
  lng              Float
  imagePlaceholder String
  image            String?
  photoCount       Int
  gallery          String[]
  description      String
  rooms            Json
  floorPlans       Json?
  principal        Json
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  interest   String   // "buying" | "renting" | "management" | "other" | "newsletter" | concierge types
  message    String?
  propertyId String?
  status     String   @default("New") // "New" | "Contacted" | "Qualified" | "Lost"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AgencySettings {
  id              String  @id @default("singleton")
  agencyName      String  @default("Kreebz Ltd")
  agencyEmail     String  @default("hello@kreebzltd.com")
  agencyPhone     String  @default("+234 806 994 9948")
  agencyAddress   String  @default("")
  principalName   String  @default("Michael Eugene")
  principalTitle  String  @default("Key Principal")
  notifyNewLeads  Boolean @default(true)
  notifyEmail     String  @default("")
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
