generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Property {
  id               String   @id
  slug             String   @unique
  price            String
  address          String
  neighbourhood    String
  city             String
  beds             Int
  baths            Int
  status           String
  type             String
  priceValue       Int
  lat              Float
  lng              Float
  imagePlaceholder String
  /// @deprecated Use PropertyMedia instead
  image            String?
  photoCount       Int
  /// @deprecated Use PropertyMedia instead
  gallery          String[]
  description      String
  rooms            Json
  floorPlans       Json?
  principal        Json

  publicationStatus PublicationStatus @default(DRAFT)
  media             PropertyMedia[]
  savedBy           SavedProperty[]
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  altText    String?
  mimeType   String
  size       Int
  isCover    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  interest   String // "buy" | "rent" | "sell" | "develop" | "facility-management" | "other" | "newsletter" | concierge types
  message    String?
  propertyId String?
  status     String   @default("New") // "New" | "Contacted" | "Qualified" | "Consultation booked" | "Viewing booked" | "Nurture" | "Closed" | "Not suitable" | "Lost"

  // Contextual enquiry fields
  project          String? // "bourdillon" | "other" | "not-sure"
  nextStep         String? // "brochure" | "call" | "consultation" | "viewing" | "info"
  timeframe        String? // "immediately" | "1-3-months" | "3-6-months" | "6-12-months" | "researching"
  preferredContact String? // "email" | "phone" | "whatsapp"
  consent          Boolean @default(false)

  // Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  landingPage String?

  // Response workflow
  assignedTo      String?
  firstResponseAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AgencySettings {
  id             String   @id @default("singleton")
  agencyName     String   @default("Kreebz Ltd")
  agencyEmail    String   @default("hello@kreebzltd.com")
  agencyPhone    String   @default("+234 806 994 9948")
  agencyAddress  String   @default("")
  principalName  String   @default("Michael Eugene")
  principalTitle String   @default("Key Principal")
  notifyNewLeads Boolean  @default(true)
  notifyEmail    String   @default("")
  updatedAt      DateTime @updatedAt
}



model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  savedProperties SavedProperty[]
  jetBookings     JetBooking[]
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Jet {
  id             String   @id @default(cuid())
  tailNumber     String   @unique
  name           String
  class          String   // "Light Jet" | "Midsize Jet" | "Heavy Jet"
  passengers     Int
  range          String
  baseHourlyRate BigInt   // Stored in smallest currency unit (kobo)
  image          String?
  status         String   @default("Active") // "Active" | "Maintenance"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  bookings       JetBooking[]
}

model JetBooking {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  jetId            String
  jet              Jet      @relation(fields: [jetId], references: [id])
  
  startDate        DateTime
  endDate          DateTime
  route            String
  passengers       Int
  
  status           String   @default("Pending") // "Pending" | "Confirmed" | "Completed" | "Cancelled"
  paymentStatus    String   @default("Unpaid")  // "Unpaid" | "Paid" | "Refunded"
  totalAmount      BigInt   // In smallest currency unit (kobo)
  paymentReference String?  @unique
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
